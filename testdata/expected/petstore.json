{
  "components": {
    "schemas": {
      "EventType": {
        "description": "EventType describes the kind of lifecycle event for a pet.",
        "enum": [
          "created",
          "updated",
          "viewed",
          "deleted"
        ],
        "type": "string",
        "x-enum-varnames": [
          "EventTypeCreated",
          "EventTypeUpdated",
          "EventTypeViewed",
          "EventTypeDeleted"
        ],
        "x-enumdescriptions": [
          "EventTypeCreated is emitted when a pet record is first inserted.",
          "EventTypeUpdated is emitted when any field on a pet is changed.",
          "EventTypeViewed is emitted when a pet detail page is fetched.",
          "EventTypeDeleted is emitted when a pet record is removed."
        ]
      },
      "PetEvent": {
        "description": "PetEvent records a lifecycle event for a pet. Demonstrates third-party / stdlib struct field usage: - time.Time → OpenAPI string (format: date-time) - map[string]string → OpenAPI object with additionalProperties",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": "1"
          },
          "pet_id": {
            "type": "integer",
            "format": "int64",
            "example": "1"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "detail": {
            "type": "string",
            "example": "pet was created via API"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "OrderItem": {
        "description": "OrderItem is a single line item inside an order.",
        "type": "object",
        "required": [
          "pet_id",
          "quantity"
        ],
        "properties": {
          "pet_id": {
            "type": "integer",
            "format": "int64",
            "example": "1"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "example": "2"
          },
          "note": {
            "type": "string",
            "example": "gift wrap please"
          }
        }
      },
      "Address": {
        "description": "Address is a physical mailing address embedded in orders.",
        "type": "object",
        "required": [
          "street",
          "city",
          "country"
        ],
        "properties": {
          "street": {
            "type": "string",
            "example": "123 Main St"
          },
          "city": {
            "type": "string",
            "example": "San Francisco"
          },
          "country": {
            "type": "string",
            "example": "US"
          },
          "zip_code": {
            "type": "string",
            "example": "94105"
          }
        }
      },
      "CreateOrderRequest": {
        "description": "CreateOrderRequest demonstrates a deeply nested request body:   - ShippingAddress Address    inline struct value (required)   - BillingAddress  *Address   same struct, nullable pointer   - Items           []OrderItem array of structs   - PlacedAt        time.Time  stdlib → string/date-time",
        "type": "object",
        "required": [
          "customer_name",
          "shipping_address",
          "items"
        ],
        "properties": {
          "customer_name": {
            "type": "string",
            "example": "Alice"
          },
          "shipping_address": {
            "$ref": "#/components/schemas/Address"
          },
          "billing_address": {
            "$ref": "#/components/schemas/Address"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "note": {
            "type": "string",
            "example": "please deliver by Friday"
          },
          "placed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderStatus": {
        "description": "OrderStatus is the fulfilment state of an order.",
        "enum": [
          "pending",
          "paid",
          "shipped",
          "delivered",
          "cancelled"
        ],
        "type": "string",
        "x-enum-varnames": [
          "OrderStatusPending",
          "OrderStatusPaid",
          "OrderStatusShipped",
          "OrderStatusDelivered",
          "OrderStatusCancelled"
        ],
        "x-enumdescriptions": [
          "OrderStatusPending means the order has been placed but not yet paid.",
          "OrderStatusPaid means payment has been confirmed.",
          "OrderStatusShipped means the order is in transit.",
          "OrderStatusDelivered means the order has been received by the customer.",
          "OrderStatusCancelled means the order was cancelled before shipment."
        ]
      },
      "Order": {
        "description": "Order is the persisted order returned by the API.",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": "1"
          },
          "customer_name": {
            "type": "string",
            "example": "Alice"
          },
          "shipping_address": {
            "$ref": "#/components/schemas/Address"
          },
          "billing_address": {
            "$ref": "#/components/schemas/Address"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "note": {
            "type": "string",
            "example": "please deliver by Friday"
          },
          "placed_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Category": {
        "description": "Category is a self-referential tree node. Children []*Category creates a recursive schema; swag3 breaks the cycle by emitting a $ref on the second encounter of the same type.",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": "1"
          },
          "name": {
            "type": "string",
            "example": "Dogs"
          },
          "parent_id": {
            "type": "integer",
            "format": "int64",
            "example": "0",
            "nullable": true
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "SearchFilter": {
        "description": "SearchFilter is intentionally defined inside the function body to demonstrate function-local struct support in swag3.",
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PagedList": {
        "description": "PagedList is the pagination payload carried inside BaseResponse.Data. List holds the concrete item slice for the current page.",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "example": "42"
          },
          "list": {}
        }
      },
      "PetStatus": {
        "description": "PetStatus is the lifecycle state of a pet.",
        "enum": [
          "available",
          "pending",
          "sold"
        ],
        "type": "string",
        "x-enum-varnames": [
          "PetStatusAvailable",
          "PetStatusPending",
          "PetStatusSold"
        ],
        "x-enumdescriptions": [
          "PetStatusAvailable means the pet is visible and can be adopted.",
          "PetStatusPending means an adoption application is in progress.",
          "PetStatusSold means the pet has been adopted and is no longer listed."
        ]
      },
      "PetTag": {
        "description": "PetTag is a free-form label for filtering pets.",
        "type": "string"
      },
      "CreatePetRequest": {
        "description": "CreatePetRequest is the request body for creating a pet.",
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Buddy"
          },
          "status": {
            "$ref": "#/components/schemas/PetStatus"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PetTag"
            }
          }
        }
      },
      "UploadResult": {
        "description": "UploadResult carries metadata about a successfully uploaded file. Returned in BaseResponse.Data after a multipart upload.",
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "example": "avatar.jpg"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "example": "204800"
          },
          "content_type": {
            "type": "string",
            "example": "image/jpeg"
          },
          "url": {
            "type": "string",
            "example": "/api/v1/pets/1/avatar"
          }
        }
      },
      "CreateCategoryRequest": {
        "description": "CreateCategoryRequest is the body for POST /categories.",
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Dogs"
          },
          "parent_id": {
            "type": "integer",
            "format": "int64",
            "example": "1",
            "nullable": true
          }
        }
      },
      "ImportItem": {
        "description": "ImportItem describes a single pet to import.",
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ImportRequest": {
        "description": "ImportRequest is the top-level body for the import endpoint.",
        "type": "object",
        "required": [
          "source",
          "items"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "dry_run": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportItem"
            }
          }
        }
      },
      "BaseResponse": {
        "description": "BaseResponse is the universal response envelope for every API endpoint. Successful responses use code=0; application errors use a non-zero code. The Data field is overridden per endpoint via composite annotations, e.g.:  \t@Success 200 {object} BaseResponse{data=Pet} \t@Success 200 {object} BaseResponse{data=PagedList}",
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": "0"
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {}
        }
      },
      "Pet": {
        "description": "Pet represents a pet in the store. Demonstrates stdlib time.Time fields mapped to OpenAPI string/date-time.",
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": "1"
          },
          "name": {
            "type": "string",
            "example": "Buddy"
          },
          "status": {
            "$ref": "#/components/schemas/PetStatus"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PetTag"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      }
    }
  },
  "info": {
    "title": "Pet Store API",
    "description": "A sample Pet Store API demonstrating swag3 annotation support.",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "https://localhost:8088/api/v1"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "tags": [
          "pets"
        ],
        "summary": "List pets (paginated)",
        "description": "ListPets returns a paginated list of pets. Demonstrates composite-type annotation: PageResult{data=[]Pet} overrides the generic `data interface{}` field with a concrete []Pet.",
        "operationId": "listPets",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "filter by status (available, pending, sold)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "page number (1-based, default 1)",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "items per page (default 20, max 100)",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "paginated pet list",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/PagedList"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "list": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/Pet"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "pets"
        ],
        "summary": "Create a new pet",
        "description": "CreatePet adds a new pet to the store.",
        "operationId": "createPet",
        "requestBody": {
          "description": "pet to create",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "created pet",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Pet"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/pets/{id}": {
      "get": {
        "tags": [
          "pets"
        ],
        "summary": "Get a pet by ID",
        "description": "GetPet returns a single pet by ID.",
        "operationId": "getPet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "pet ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the requested pet",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Pet"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "404": {
            "description": "pet not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "pets"
        ],
        "summary": "Update an existing pet",
        "description": "UpdatePet replaces an existing pet record.",
        "operationId": "updatePet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "pet ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "updated pet data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "updated pet",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Pet"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid id or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "404": {
            "description": "pet not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "pets"
        ],
        "summary": "Delete a pet",
        "description": "DeletePet removes a pet from the store.",
        "operationId": "deletePet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "pet ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "pet deleted (no body)"
          },
          "400": {
            "description": "invalid id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "404": {
            "description": "pet not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/pets/search": {
      "post": {
        "tags": [
          "pets"
        ],
        "summary": "Search pets by keyword, status, and tags",
        "description": "SearchPets performs an advanced keyword + status search. Demonstrates function-local struct: SearchFilter is defined inside this function body. swag3 registers it automatically because this function carries a @Router annotation.",
        "operationId": "searchPets",
        "requestBody": {
          "description": "search criteria",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchFilter"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "matching pets (single page)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/PagedList"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "list": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/Pet"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid search request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/pets/{id}/events": {
      "get": {
        "tags": [
          "pets"
        ],
        "summary": "Get lifecycle events for a pet",
        "description": "GetPetEvents lists lifecycle events for a pet. Demonstrates PetEvent whose fields use stdlib (time.Time) and map (map[string]string) types that map to OpenAPI primitives.",
        "operationId": "getPetEvents",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "pet ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "description": "filter by event type (created, updated, viewed, …)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "list of events",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PetEvent"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "404": {
            "description": "pet not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{id}/avatar": {
      "get": {
        "tags": [
          "pets"
        ],
        "summary": "Download pet avatar",
        "description": "DownloadPetAvatar streams the stored avatar image back to the caller. The response Content-Type matches the format of the uploaded file. Demonstrates a binary (application/octet-stream) download endpoint.",
        "operationId": "downloadPetAvatar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "pet ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "avatar image bytes"
          },
          "400": {
            "description": "invalid id",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "404": {
            "description": "pet or avatar not found",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
